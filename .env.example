APP_NAME=AreaValidationAPI
APP_ENV=dev
LOG_LEVEL=INFO

HOST=0.0.0.0
PORT=8000

ETH_RPC_URL=https://sepolia.infura.io/v3/your-key
PROJECT_MANAGER_ADDRESS=0x0000000000000000000000000000000000000000
PROJECT_MANAGER_ABI=[]

PINATA_GATEWAY_BASE_URL=https://gateway.pinata.cloud/ipfs
PINATA_JWT=replace-with-pinata-jwt

RPC_TIMEOUT_SECONDS=10
IPFS_TIMEOUT_SECONDS=20
BATCH_TIMEOUT_SECONDS=60
MAX_CONCURRENT_DOWNLOADS=25
MAX_APPROVED_CELLS=10000
